int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    
    int* result = (int*)malloc(100 * sizeof(int));
    
    if (result == NULL) {
        *returnSize = 0;
        return NULL;
    }


    *returnSize = traverse(root, result, 0);

    return result;
}


int traverse(struct TreeNode* root, int* result, int count) {
    if (root == NULL) {
        return count;
    }

    
    result[count] = root->val;
    count++;
    count = traverse(root->left, result, count);

    
    count = traverse(root->right, result, count);

    return count;
}

